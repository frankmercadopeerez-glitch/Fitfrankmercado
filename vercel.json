{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/planes/", "destination": "/program/", "permanent": true },
    { "source": "/tienda/", "destination": "/es-us/programa/", "permanent": true },
    { "source": "/politica-privacidad/", "destination": "/es-us/legal/privacidad/", "permanent": true },
    { "source": "/terminos-condiciones/", "destination": "/es-us/legal/terminos/", "permanent": true },
    { "source": "/success/", "destination": "/thanks/", "permanent": true },
    { "source": "/freeplan/formulario.html", "destination": "/es-us/formulario/", "permanent": true },
    { "source": "/formulario/", "destination": "/es-us/formulario/", "permanent": true },
    { "source": "/freeplan/(.*)", "destination": "/es-us/gratis/", "permanent": true },
    { "source": "/guia/(.*)", "destination": "/es-us/programa/", "permanent": true },
    { "source": "/guias/(.*)", "destination": "/es-us/programa/", "permanent": true },
    { "source": "/tienda/(.*)", "destination": "/es-us/programa/", "permanent": true },
    { "source": "/blog/como-empezar-entrenamiento/", "destination": "/es-us/recursos/entrenamiento-fuerza-trabajadores-turnos/", "permanent": true },
    { "source": "/blog/habitos-saludables/", "destination": "/es-us/recursos/entrenamiento-fuerza-trabajadores-turnos/", "permanent": true },
    { "source": "/blog/cardio-para-bajar-de-peso/", "destination": "/es-us/recursos/entrenamiento-fuerza-trabajadores-turnos/", "permanent": true },
    { "source": "/blog/(.*)", "destination": "/es-us/recursos/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
